---
pagination:
  data: productIndexPages
  size: 1
  alias: entry
permalink: "{{ entry.route.outputPath }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<!-- GENERATED FILE. Edit site-src/product-index.njk or site-src/_data/productDirectory.js. -->
<html lang="{{ entry.copy.lang }}" dir="{{ entry.copy.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
{% seoTags entry.seo %}
  <link rel="icon" href="{{ entry.route.assetPrefix }}favicon.ico">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/catalog-pages.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/site-navigation.css">
</head>
<body data-site-language="{{ entry.copy.lang }}" data-site-route-id="{{ entry.routeId or 'products' }}">
{% include "site-header.njk" %}
  <main>
    <section class="catalog-hero"><div class="catalog-shell"><p class="catalog-eyebrow">{{ entry.copy.directoryEyebrow }}</p><h1>{{ entry.copy.directoryTitle }}</h1><p>{{ entry.copy.directoryLead }}</p></div></section>
    <section class="catalog-section" data-product-finder><div class="catalog-shell">
      <div class="finder-controls" hidden>
        <label for="product-search">{% if entry.locale == 'ar' %}البحث بالاسم أو الموديل أو المقاس{% else %}Search by name, model or size{% endif %}</label>
        <input id="product-search" type="search" autocomplete="off" aria-controls="product-results">
        <label for="product-family">{% if entry.locale == 'ar' %}فئة المنتج{% else %}Product category{% endif %}</label>
        <select id="product-family"><option value="">{% if entry.locale == 'ar' %}جميع المنتجات{% else %}All products{% endif %}</option>{% for group in entry.browseGroups %}{% if group.families.length > 1 %}<optgroup label="{{ group.name }}"><option value="{{ group.id }}" data-family-members="{{ group.members }}">{% if entry.locale == 'ar' %}عرض الكل — {% else %}All — {% endif %}{{ group.name }}</option>{% for family in group.families %}<option value="{{ family.id }}" data-family-members="{{ family.id }}">{{ family.name }}</option>{% endfor %}</optgroup>{% else %}<option value="{{ group.id }}" data-family-members="{{ group.members }}">{{ group.name }}</option>{% endif %}{% endfor %}</select>
        <button type="button" data-finder-reset>{% if entry.locale == 'ar' %}إعادة تعيين{% else %}Clear filters{% endif %}</button>
        <p data-finder-count role="status" aria-live="polite"></p>
        <p class="finder-help">{% if entry.locale == 'ar' %}يشمل البحث الموديلات والمقاسات المدرجة داخل صفحات المنتجات. راجع جدول الموديلات للتكوين المطلوب؛ تُظهر الصور العينة الموصوفة.{% else %}Search includes models and sizes listed on product pages. Check the model table for your required configuration; photos show the labeled sample.{% endif %}</p>
      </div>
      <nav class="finder-shortcuts" aria-label="{{ entry.copy.products }}">{% for group in entry.browseGroups %}<a href="#{{ group.id }}">{{ group.name }}</a>{% endfor %}</nav>
      {% for group in entry.browseGroups %}{% if group.families.length > 1 %}<span id="{{ group.id }}" class="finder-group-anchor" aria-hidden="true"></span>{% endif %}{% endfor %}
      <nav class="finder-pagination" data-finder-pagination hidden aria-label="{% if entry.locale == 'ar' %}صفحات المنتجات{% else %}Product pages{% endif %}"><button type="button" data-page-prev>{% if entry.locale == 'ar' %}السابق{% else %}Previous{% endif %}</button><span data-page-label role="status" aria-live="polite"></span><button type="button" data-page-next>{% if entry.locale == 'ar' %}التالي{% else %}Next{% endif %}</button></nav>
      <div id="product-results">{% for family in entry.families %}<section class="finder-family" id="{{ family.id }}" data-family="{{ family.id }}"><div class="catalog-section__heading"><h2>{{ family.name }}</h2></div><div class="product-grid">
      {% set directoryMode = true %}{% for product in family.products %}{% include "catalog-product-card.njk" %}{% endfor %}
      </div></section>{% endfor %}</div>
      <nav class="finder-pagination" data-finder-pagination hidden aria-label="{% if entry.locale == 'ar' %}صفحات المنتجات{% else %}Product pages{% endif %}"><button type="button" data-page-prev>{% if entry.locale == 'ar' %}السابق{% else %}Previous{% endif %}</button><span data-page-label role="status" aria-live="polite"></span><button type="button" data-page-next>{% if entry.locale == 'ar' %}التالي{% else %}Next{% endif %}</button></nav>
      <p data-finder-empty hidden>{% if entry.locale == 'ar' %}لم يتم العثور على منتجات. جرّب الموديل أو المقاس أو اسماً آخر، أو امسح عوامل التصفية.{% else %}No products found. Try a model, size or another product name, or clear the filters.{% endif %} <a href="#inquiry">{{ entry.copy.inquiryTitle }} →</a></p>
    </div></section>
    <section class="catalog-selection"><div class="catalog-shell catalog-selection__grid"><div><p class="catalog-eyebrow">{{ entry.copy.selectionEyebrow }}</p><h2>{{ entry.copy.selectionTitle }}</h2><p>{{ entry.copy.selectionLead }}</p></div><ul>{% for item in entry.copy.selectionItems %}<li>{{ item }}</li>{% endfor %}</ul></div></section>
{% include "listing-inquiry.njk" %}
  </main>
  <footer class="catalog-footer"><div class="catalog-shell"><span>© 2026 CHUANWEI FIRE</span><a href="{{ entry.route.homeHref }}">{{ entry.copy.home }}</a></div></footer>
  <script src="{{ entry.route.assetPrefix }}assets/js/site-navigation.js"></script>
  <script src="{{ entry.route.assetPrefix }}assets/js/product-finder.js?v=20261009-1"></script>
</body>
</html>
