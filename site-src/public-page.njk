---
pagination:
  data: publicPages
  size: 1
  alias: entry
permalink: "{{ entry.route.outputPath }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<!-- GENERATED FILE. Edit site-src/public-page.njk or site-src/_data/publicPages.js. -->
<html lang="{{ entry.copy.lang }}" dir="{{ entry.copy.dir }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{% seoTags entry.seo %}
  <link rel="icon" href="{{ entry.route.assetPrefix }}favicon.ico"><link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/public-pages.css"><link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/site-navigation.css">
</head>
<body data-site-language="{{ entry.copy.lang }}" data-site-route-id="{{ entry.routeId }}">
  <a class="skip-link" href="#main">{{ entry.copy.skip }}</a>
{% include "site-header.njk" %}
  <main id="main"><section class="page-hero"><div class="container"><p class="eyebrow">{{ entry.copy.eyebrow }}</p><h1>{{ entry.copy.heroTitle }}</h1><p>{{ entry.copy.heroLead }}</p></div></section>
{% if entry.pageType == 'about' %}
    <section class="section"><div class="container two-column"><div class="photo-panel"><img src="{{ entry.route.assetPrefix }}assets/home/factory/precision-manufacturing-hd.jpg" alt="{{ entry.copy.heroTitle }}"></div><div class="content"><h2>{{ entry.copy.introTitle }}</h2>{% for paragraph in entry.copy.intro %}<p>{{ paragraph }}</p>{% endfor %}<div class="feature-grid">{% for feature in entry.copy.features %}<div class="feature"><strong>{{ feature[0] }}</strong><span>{{ feature[1] }}</span></div>{% endfor %}</div></div></div></section>
    <section class="section soft"><div class="container"><div class="section-heading"><div><h2>{{ entry.copy.capabilitiesTitle }}</h2></div><p>{{ entry.copy.capabilitiesLead }}</p></div><div class="card-grid">{% for capability in entry.copy.capabilities %}<article class="info-card"><h3>{{ capability[0] }}</h3><p>{{ capability[1] }}</p></article>{% endfor %}</div></div></section>
    <section class="section"><div class="container two-column"><div class="content"><p class="eyebrow">OEM / ODM</p><h2>{{ entry.copy.oemTitle }}</h2><p>{{ entry.copy.oemBody }}</p><div class="feature-grid">{% for item in entry.copy.oemItems %}<div class="feature"><strong>{{ item[0] }}</strong><span>{{ item[1] }}</span></div>{% endfor %}</div></div><div class="photo-panel"><img src="{{ entry.route.assetPrefix }}assets/home/packaging/wooden-case.jpg" alt="{{ entry.copy.oemTitle }}"></div></div></section>
    <section class="section soft"><div class="container"><div class="note">{{ entry.copy.certificateNote }}</div><a class="btn navy" href="{{ entry.route.downloadsHref }}">{{ entry.copy.downloadCta }}</a></div></section>
{% elif entry.pageType == 'downloads' %}
    <section class="section soft"><div class="container"><div class="card-grid">{% for resource in entry.copy.resources %}<article class="info-card"><h2>{{ resource[0] }}</h2><p>{{ resource[1] }}</p><a class="more" {% if resource[2] == 'catalog' %}data-catalog-request target="_blank" rel="noopener" href="{{ entry.whatsapp }}">{{ entry.copy.catalogAction }}{% else %}href="{{ entry.route.contactHref }}">{{ entry.copy.contactAction }}{% endif %}</a></article>{% endfor %}</div></div></section>
    <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{{ entry.copy.certificatesEyebrow }}</p><h2>{{ entry.copy.certificatesTitle }}</h2></div><p>{{ entry.copy.certificatesLead }}</p></div><div class="note">{{ entry.copy.holderNote }}</div><div class="certificate-grid">{% for certificate in entry.certificates %}<article class="certificate"><a href="{{ certificate.href }}" target="_blank" rel="noopener"><img src="{{ certificate.href }}" alt="{{ certificate.standard }}"></a><h3>{{ certificate.standard }}</h3><p>{{ certificate.description }} · {{ certificate.number }}</p><a class="more" href="{{ certificate.href }}" target="_blank" rel="noopener">{{ entry.copy.viewFile }}</a></article>{% endfor %}</div></div></section><section class="section soft"><div class="container"><div class="note">{{ entry.copy.finalNote }}</div></div></section>
{% else %}
    <section class="section contact-section"><div class="container contact-grid"><div class="contact-copy"><p class="eyebrow">{{ entry.copy.inquiryEyebrow }}</p><h2>{{ entry.copy.inquiryTitle }}</h2><p>{{ entry.copy.inquiryBody }}</p><div class="contact-links"><a dir="ltr" href="{{ entry.whatsapp }}" target="_blank" rel="noopener">WhatsApp: +86 173 2652 8368</a><a dir="ltr" href="mailto:{{ entry.email }}">Email: {{ entry.email }}</a><span>{{ entry.copy.location }}</span></div></div><form class="form" data-inquiry-form><div class="form-row"><label>{{ entry.copy.form.name }}<input name="name" required autocomplete="name"></label><label>{{ entry.copy.form.destination }}<input name="destination" required></label></div><div class="form-row"><label>{{ entry.copy.form.product }}<select name="product">{% for option in entry.copy.productOptions %}<option value="{{ option[0] }}">{{ option[1] }}</option>{% endfor %}</select></label><label>{{ entry.copy.form.quantity }}<input name="quantity" placeholder="{{ entry.copy.form.quantityPlaceholder }}"></label></div><label>{{ entry.copy.form.details }}<textarea name="details" required placeholder="{{ entry.copy.form.detailsPlaceholder }}"></textarea></label><button class="btn" type="submit">{{ entry.copy.form.submit }}</button></form></div></section>
    <section class="section soft"><div class="container"><div class="section-heading"><div><p class="eyebrow">{{ entry.copy.checklistEyebrow }}</p><h2>{{ entry.copy.checklistTitle }}</h2></div><p>{{ entry.copy.checklistLead }}</p></div><div class="card-grid">{% for item in entry.copy.checklist %}<article class="info-card"><h3>{{ item[0] }}</h3><p>{{ item[1] }}</p></article>{% endfor %}</div></div></section>
{% endif %}</main>
  <footer class="site-footer"><div class="container footer-inner"><div><strong>CHUANWEI FIRE</strong><br>{{ entry.copy.footerSummary }}</div><div class="footer-disclaimer">{{ entry.copy.footerDisclaimer }}</div><div>© <span data-current-year>2026</span></div></div></footer><a class="social-float" href="{{ entry.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">W</a><script src="{{ entry.route.assetPrefix }}assets/js/site-navigation.js"></script><script src="{{ entry.route.assetPrefix }}assets/js/public-pages.js"></script>
</body></html>
