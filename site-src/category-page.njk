---
pagination:
  data: categoryPages
  size: 1
  alias: entry
permalink: "{{ entry.route.outputPath }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<!-- GENERATED FILE. Edit site-src/category-page.njk or site-src/_data/productDirectory.js. -->
<html lang="{{ entry.copy.lang }}" dir="{{ entry.copy.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
{% seoTags entry.seo %}
  <link rel="icon" href="{{ entry.route.assetPrefix }}favicon.ico">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/catalog-pages.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/site-navigation.css">
</head>
<body data-site-language="{{ entry.copy.lang }}" data-site-route-id="{{ entry.routeId or entry.navigation.routeId }}">
{% include "site-header.njk" %}
  <main>
    <section class="catalog-hero category-hero"><div class="catalog-shell category-hero__grid"><div><p class="catalog-eyebrow">{{ entry.copy.categoryEyebrow }}</p><h1>{{ entry.familyName }}</h1><p>{{ entry.familyDescription }}</p><div class="category-hero__actions"><a class="catalog-button" href="#products">{{ entry.copy.availableProducts }}</a><a class="catalog-button catalog-button--ghost" href="{{ entry.whatsappHref }}" target="_blank" rel="noopener">{{ entry.copy.whatsapp }}</a></div></div><div class="category-hero__image"><img src="{{ entry.heroImage }}" alt="{{ entry.familyName }}"></div></div></section>
{% if entry.guide %}
    <section class="catalog-section catalog-focus"><div class="catalog-shell"><div class="catalog-section__heading"><h2>{{ entry.guide.guideTitle }}</h2><p>{{ entry.guide.guideIntro }}</p></div><ul class="catalog-focus__list">{% for item in entry.guide.guideItems %}<li>{{ item }}</li>{% endfor %}</ul><a class="catalog-focus__link" href="{{ entry.guide.href }}">{{ entry.guide.focusLink }} →</a></div></section>
{% endif %}
    <section class="catalog-section" id="products"><div class="catalog-shell"><div class="catalog-section__heading"><div><p class="catalog-eyebrow">{{ entry.copy.availableProducts }}</p><h2>{{ entry.familyName }}</h2></div><p>{{ entry.copy.categoryNote }}</p></div><div class="product-grid">
      {% for product in entry.products %}<article class="product-card"><a class="product-card__image" href="{{ product.href }}"><img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy" decoding="async" width="480" height="480"></a><div class="product-card__body"><span class="product-card__badge product-card__badge--{{ product.linkType }}">{% if product.linkType == 'localized' %}{{ entry.copy.localizedBadge }}{% elif product.linkType == 'english' %}{{ entry.copy.fallbackBadge }}{% else %}{{ entry.copy.inquiryBadge }}{% endif %}</span><h3>{{ product.name }}</h3>{% if product.configurations.length %}<nav class="configuration-links">{% for configuration in product.configurations %}<a href="{{ configuration.href }}">{{ configuration.name }} →</a>{% endfor %}</nav>{% endif %}<a class="product-card__link" href="{{ product.href }}">{% if product.linkType == 'localized' %}{{ entry.copy.localizedDetails }}{% elif product.linkType == 'english' %}{{ entry.copy.englishDetails }}{% else %}{{ entry.copy.requestDetails }}{% endif %} <span aria-hidden="true">→</span></a></div></article>{% endfor %}
    </div></div></section>
    <section class="catalog-selection"><div class="catalog-shell catalog-selection__grid"><div><p class="catalog-eyebrow">OEM / ODM</p><h2>{{ entry.copy.selectionTitle }}</h2><p>{{ entry.copy.selectionLead }}</p></div><ul>{% for item in entry.copy.selectionItems %}<li>{{ item }}</li>{% endfor %}</ul></div></section>
    <section class="catalog-cta"><div class="catalog-shell catalog-cta__in"><div><h2>{{ entry.copy.inquiryTitle }}</h2><p>{{ entry.copy.inquiryBody }}</p></div><a class="catalog-button" href="{{ entry.whatsappHref }}" target="_blank" rel="noopener">{{ entry.copy.whatsapp }}</a></div></section>
  </main>
  <footer class="catalog-footer"><div class="catalog-shell"><span>© 2026 CHUANWEI FIRE</span><a href="{{ entry.route.productsHref }}">{{ entry.copy.backToDirectory }}</a></div></footer>
  <script src="{{ entry.route.assetPrefix }}assets/js/site-navigation.js"></script>
</body>
</html>
