{% if product.relatedConfigurations.length %}<details class="product-card__models"><summary>{% if entry.locale == 'ar' %}موديلات ومواصفات إضافية{% else %}Additional models and specifications{% endif %}</summary><nav class="configuration-links">{% for configuration in product.relatedConfigurations %}<a href="{{ configuration.href }}"{% if configuration.searchText %} data-related-model data-related-search="{{ configuration.searchText }}" data-model-name="{{ configuration.name }}" data-model-image="{{ configuration.image or '' }}" data-model-image-caption="{{ configuration.imageCaption }}"{% endif %}>{{ configuration.name }} →</a>{% endfor %}</nav></details>{% endif %}
