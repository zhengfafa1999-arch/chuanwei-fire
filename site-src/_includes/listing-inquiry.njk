    <section class="catalog-cta" id="inquiry"><div class="catalog-shell">
      <div class="catalog-cta__in"><div><h2>{{ entry.copy.inquiryTitle }}</h2><p>{{ entry.copy.inquiryBody }}</p></div>
        <div class="catalog-cta__actions"><a class="catalog-button" href="{{ entry.whatsappHref }}" target="_blank" rel="noopener">{{ entry.copy.whatsapp }}</a><a class="catalog-button catalog-button--ghost" href="{{ entry.emailHref }}">{{ entry.copy.emailDraft }}</a></div>
      </div>
      <p class="catalog-cta__note">{{ entry.copy.inquiryNote }} <a href="{{ entry.route.contactHref }}">{{ entry.copy.contactDetails }} →</a></p>
    </div></section>
