<nav class="pdp-section-navigation" aria-label="{{ entry.text.onThisPage }}"><div class="pdp-section-navigation__links"><a href="#specifications">{{ entry.text.specifications }}</a><a href="#models">{{ entry.text.availableModels }}</a><a href="#oem">{{ entry.text.oEMODM }}</a></div></nav>

<main>
    <section class="pdp-hero">
      <div class="pdp-container pdp-hero__grid">
        <div>
          <p class="pdp-eyebrow">{{ entry.text.fireProtectionButterflyValve }}</p>
          <h1>{{ entry.text.leverOperatedGroovedButterflyValve }}</h1>
          <p class="pdp-lead">{{ entry.text.manualLeverOperatedButterflyValveWithGroovedEnds }}</p>
          <div class="pdp-chips">{% for key in entry.product.chips %}<span>{{ entry.text[key] }}</span>{% endfor %}</div>
          <div class="pdp-actions"><a class="pdp-btn" href="{{ entry.product.inquiry.whatsapp }}" target="_blank" rel="noopener">{{ entry.text.askOnWhatsApp }}</a><a class="pdp-btn pdp-btn--ghost" href="#models">{{ entry.text.viewAvailableModels }}</a></div>
          <p class="pdp-note">{{ entry.text.grooveProfileFaceToFaceDimensionAndMarkingAre }}</p>
        </div>
        <button class="pdp-hero__image" type="button" data-lightbox="{{ entry.media.hero }}" aria-label="{{ entry.text.enlargeLeverOperatedGroovedButterflyValveImage }}"><img src="{{ entry.media.hero }}" alt="{{ entry.text.leverOperatedGroovedButterflyValveWithGroovedEndsAndVisibleLever }}" width="{{ entry.product.hero.width }}" height="{{ entry.product.hero.height }}"></button>
      </div>
    </section>

    <section class="pdp-section pdp-section--soft" id="specifications">
      <div class="pdp-container">
        <div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.text.technicalOverview }}</p><h2>{{ entry.text.confirmedConstructionAndOperatingData }}</h2></div><p>{{ entry.text.criticalProductDataIsPresentedInHTMLFor }}</p></div>
        <div class="pdp-spec-layout">
          <div class="pdp-panel"><h3>{{ entry.text.seriesSpecifications }}</h3><dl class="pdp-specs">
            {% for row in entry.product.specifications %}<div><dt>{{ entry.text[row[0]] }}</dt><dd>{{ entry.text[row[1]] }}</dd></div>
            {% endfor %}</dl></div>
          <aside class="pdp-panel"><h3>{{ entry.text.operation }}</h3>
            <div class="wav-switch-grid">{% for card in entry.product.operationCards %}<div><span>{{ entry.text[card[0]] }}</span><strong>{{ entry.text[card[1]] }}</strong><small>{{ entry.text[card[2]] }}</small></div>{% endfor %}</div>
            {% for item in entry.product.disclaimers %}<div class="pdp-disclaimer"><strong>{{ entry.text[item[0]] }}</strong>{{ entry.text[item[1]] }}</div>
            {% endfor %}</aside>
        </div>
      </div>
    </section>

    <section class="pdp-section pdp-section--soft" id="models">
      <div class="pdp-container">
        <div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.text.availableModels }}</p><h2>{{ entry.text.configurationsForQuotation }}</h2></div><p>{{ entry.text.internationalSizeAndConnectionAreThePrimarySelection }}</p></div>
        <div class="pdp-table-wrap"><table class="pdp-table"><thead><tr><th>{{ entry.text.internationalConfiguration }}</th><th>{{ entry.text.nominalSize }}</th><th>{{ entry.text.workingPressure }}</th><th>{{ entry.text.factoryReference }}</th></tr></thead><tbody>{% for row in entry.product.models %}<tr>{% for cell in row %}<td{% if entry.lang == 'ar' %} dir="auto"{% endif %}>{{ entry.text[cell] }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
        <p class="pdp-options-note">{{ entry.text.forQuotationSpecifyDNSizeGrooveProfileRequirement }}</p>
      </div>
    </section>

    <section class="pdp-section" id="oem">
      <div class="pdp-container pdp-oem">
        <div><p class="pdp-eyebrow">{{ entry.text.oEMODMCapability }}</p><h2>{{ entry.text.configuredToTheApprovedDrawingOrSample }}</h2><p>{{ entry.text.manufacturingOptionsAreConfirmedAgainstTheBuyerS }}</p></div>
        <div class="pdp-oem__grid">{% for card in entry.product.oemCards %}<div><strong>{{ entry.text[card[0]] }}</strong><span>{{ entry.text[card[1]] }}</span></div>{% endfor %}</div>
      </div>
    </section>

    <section class="pdp-cta" id="inquiry"><div class="pdp-container pdp-cta__in"><div><h2>{{ entry.text.sendYourButterflyValveSchedule }}</h2><p>{{ entry.text.includeSizeGrooveProfileRequirementQuantityAndDestination }}</p></div><div class="pdp-actions"><a class="pdp-btn" href="{{ entry.product.inquiry.whatsapp }}" target="_blank" rel="noopener">{{ entry.text.whatsAppInquiry }}</a><a class="pdp-btn pdp-btn--ghost" href="{{ entry.product.inquiry.email }}">{{ entry.text.emailSales }}</a></div></div></section>
  </main>
{% include "product-footer.njk" %}
<div class="pdp-modal" id="productModal" role="dialog" aria-modal="true" aria-label="{{ entry.text.productImagePreview }}"><button type="button" aria-label="{{ entry.text.closeImagePreview }}">×</button><div><img src="{{ entry.media.hero }}" alt="{{ entry.text.enlargedLeverOperatedGroovedButterflyValve }}"></div></div>

