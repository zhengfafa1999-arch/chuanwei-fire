<article class="product-card"{% if directoryMode %} data-search="{{ product.searchText }}"{% endif %}{% if product.seriesId %} id="series-{{ product.seriesId }}" data-sprinkler-series="{{ product.seriesId }}"{% endif %}>{% if product.image %}<a class="product-card__image" href="{{ product.href }}"><img{% if directoryMode %} class="finder-js-image"{% endif %} src="{{ product.image }}" alt="{{ product.name }}" width="480" height="480" loading="lazy" decoding="async"></a>{% elif product.inquiry %}<div class="product-card__series-label"><span>{% if entry.locale == 'ar' %}سلسلة رشاشات{% else %}Sprinkler series{% endif %}</span><strong dir="ltr">{{ product.imageLabel }}</strong></div>{% endif %}<div class="product-card__body">{% if product.linkType != 'localized' %}<span class="product-card__badge product-card__badge--{{ product.linkType }}">{% if product.linkType == 'english' %}{{ entry.copy.fallbackBadge }}{% else %}{{ entry.copy.inquiryBadge }}{% endif %}</span>{% endif %}<h3>{% if directoryMode %}<a href="{{ product.href }}">{{ product.name }}</a>{% else %}{{ product.name }}{% endif %}</h3>{% if product.imageCaption %}<p class="product-card__reference">{{ product.imageCaption }}</p>{% endif %}{% if product.description %}<p class="product-card__description">{{ product.description }}</p>{% endif %}{% if product.configurations.length %}<nav class="configuration-links">{% for configuration in product.configurations %}<a href="{{ configuration.href }}">{{ configuration.name }} →</a>{% endfor %}</nav>{% endif %}{% include "related-product-models.njk" %}<a class="product-card__link" href="{{ product.href }}">{% if product.linkType == 'localized' %}{{ entry.copy.localizedDetails }}{% elif product.linkType == 'english' %}{{ entry.copy.englishDetails }}{% else %}{{ entry.copy.requestDetails }}{% endif %} <span aria-hidden="true">→</span></a></div></article>
