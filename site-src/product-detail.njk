---
pagination:
  data: catalog
  size: 1
  alias: entry
permalink: "{{ entry.route.outputPath }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<!-- GENERATED FILE. Edit site-src/_data, site-src/content, or site-src/_includes instead of editing this HTML directly. -->
<html lang="{{ entry.locale.lang }}" dir="{{ entry.locale.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{% seoTags entry.seo %}
  <link rel="icon" href="{{ entry.route.assetPrefix }}favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="{{ entry.route.assetPrefix }}apple-touch-icon.png">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/common.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/sprinkler-product.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/wet-alarm-valve-product.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/multilingual-product.css">
  <link rel="stylesheet" href="{{ entry.route.assetPrefix }}css/site-navigation.css">
</head>
<body data-site-language="{{ entry.locale.lang }}" data-site-route-id="{{ entry.routeId }}">
{% include "site-header.njk" %}
  <nav class="pdp-section-navigation" aria-label="{{ entry.locale.navigation.gallery }}"><div class="pdp-section-navigation__links"><a href="#gallery">{{ entry.locale.navigation.gallery }}</a><a href="#specifications">{{ entry.locale.navigation.specifications }}</a><a href="#models">{{ entry.locale.navigation.models }}</a><a href="#oem">{{ entry.locale.navigation.oem }}</a></div></nav>

  <main>
    <section class="pdp-hero wav-hero">
      <div class="pdp-container pdp-hero__grid">
        <div>
          <p class="pdp-eyebrow">{{ entry.copy.eyebrow }}</p>
          <h1>{{ entry.copy.name }}</h1>
          <p class="pdp-lead">{{ entry.copy.lead }}</p>
          <div class="pdp-chips">{% for chip in entry.chips %}<span><bdi dir="auto">{{ chip }}</bdi></span>{% endfor %}</div>
          <div class="pdp-actions"><a class="pdp-btn" href="{{ entry.whatsAppHref }}" target="_blank" rel="noopener">{{ entry.copy.askWhatsApp }}</a><a class="pdp-btn pdp-btn--ghost" href="#models">{{ entry.copy.viewModels }}</a></div>
          <p class="pdp-note">{{ entry.copy.heroNote }}</p>
        </div>
        <button class="pdp-hero__image" type="button" data-lightbox="{{ entry.heroImage.src }}" aria-label="{{ entry.heroImage.alt }}"><img src="{{ entry.heroImage.src }}" alt="{{ entry.heroImage.alt }}" width="{{ entry.heroImage.width }}" height="{{ entry.heroImage.height }}"></button>
      </div>
    </section>

    <section class="pdp-section" id="gallery">
      <div class="pdp-container">
        <div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.copy.galleryEyebrow }}</p><h2>{{ entry.copy.galleryTitle }}</h2></div><p>{{ entry.copy.galleryDescription }}</p></div>
        <div class="wav-gallery" data-gallery>
          <div class="wav-gallery__stage"><button class="wav-gallery__main" type="button" data-lightbox="{{ entry.heroImage.src }}" aria-label="{{ entry.heroImage.alt }}"><img src="{{ entry.heroImage.src }}" alt="{{ entry.heroImage.alt }}" width="{{ entry.heroImage.width }}" height="{{ entry.heroImage.height }}"></button><button class="wav-gallery__arrow wav-gallery__arrow--prev" type="button" aria-label="{{ entry.locale.common.previous }}">‹</button><button class="wav-gallery__arrow wav-gallery__arrow--next" type="button" aria-label="{{ entry.locale.common.next }}">›</button></div>
          <div class="wav-gallery__meta"><strong data-gallery-title>{{ entry.heroImage.title }}</strong><span data-gallery-count>1 / {{ entry.gallery.length }}</span></div>
          <div class="wav-gallery__thumbs" role="list" aria-label="{{ entry.locale.navigation.gallery }}">{% for image in entry.gallery %}<button{% if loop.first %} class="active"{% endif %} type="button" role="listitem" data-gallery-index="{{ loop.index0 }}" data-src="{{ image.src }}" data-alt="{{ image.alt }}" data-title="{{ image.title }}"><img src="{{ image.src }}" alt="{{ image.alt }}"><span>{{ image.thumb }}</span></button>{% endfor %}</div>
        </div>
      </div>
    </section>

    <section class="pdp-section pdp-section--soft" id="specifications">
      <div class="pdp-container">
        <div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.copy.technicalEyebrow }}</p><h2>{{ entry.copy.technicalTitle }}</h2></div><p>{{ entry.copy.technicalDescription }}</p></div>
        <div class="pdp-spec-layout"><div class="pdp-panel"><h3>{{ entry.copy.seriesSpecifications }}</h3><dl class="pdp-specs">{% for row in entry.specRows %}<div><dt>{{ row.label }}</dt><dd><bdi dir="auto">{{ row.value }}</bdi></dd></div>{% endfor %}</dl></div><aside class="pdp-panel"><h3>{{ entry.detailPanel.title }}</h3>{% if entry.detailPanel.cards.length %}<div class="wav-switch-grid">{% for row in entry.detailPanel.cards %}<div><span>{{ row.label }}</span><strong class="ltr">{{ row.value }}</strong>{% if row.detail %}<small class="ltr">{{ row.detail }}</small>{% endif %}</div>{% endfor %}</div>{% endif %}{% for note in entry.detailPanel.notes %}<div class="pdp-disclaimer"><strong>{{ note.title }}</strong>{{ note.body }}</div>{% endfor %}</aside></div>
      </div>
    </section>

{% if entry.featureSection %}    <section class="pdp-section" id="{{ entry.featureSection.id }}"><div class="pdp-container"><div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.featureSection.eyebrow }}</p><h2>{{ entry.featureSection.title }}</h2></div><p>{{ entry.featureSection.description }}</p></div><div class="wav-components">{% for item in entry.featureSection.items %}<div><span>{{ item.number }}</span><strong>{{ item.text }}</strong></div>{% endfor %}</div></div></section>{% endif %}

    <section class="pdp-section pdp-section--soft" id="models"><div class="pdp-container"><div class="pdp-heading"><div><p class="pdp-eyebrow">{{ entry.copy.modelsEyebrow }}</p><h2>{{ entry.copy.modelsTitle }}</h2></div><p>{{ entry.copy.modelsDescription }}</p></div><div class="pdp-table-wrap"><table class="pdp-table"><thead><tr>{% for column in entry.modelColumns %}<th>{{ column }}</th>{% endfor %}</tr></thead><tbody>{% for model in entry.models %}<tr>{% for cell in model.cells %}<td>{% if cell.dir %}<bdi dir="{{ cell.dir }}">{{ cell.value }}</bdi>{% else %}{{ cell.value }}{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><p class="pdp-options-note">{{ entry.copy.modelsNote }}</p></div></section>

    <section class="pdp-section" id="oem"><div class="pdp-container pdp-oem"><div><p class="pdp-eyebrow">{{ entry.copy.oemEyebrow }}</p><h2>{{ entry.copy.oemTitle }}</h2><p>{{ entry.copy.oemDescription }}</p></div><div class="pdp-oem__grid">{% for item in entry.oemItems %}<div><strong>{{ item.title }}</strong><span>{{ item.body }}</span></div>{% endfor %}</div></div></section>

    <section class="pdp-cta" id="inquiry"><div class="pdp-container pdp-cta__in"><div><h2>{{ entry.copy.inquiryTitle }}</h2><p>{{ entry.copy.inquiryDescription }}</p></div><div class="pdp-actions"><a class="pdp-btn" href="{{ entry.whatsAppHref }}" target="_blank" rel="noopener">{{ entry.copy.inquiryWhatsApp }}</a><a class="pdp-btn pdp-btn--ghost" href="{{ entry.emailHref }}">{{ entry.copy.inquiryEmail }}</a></div></div></section>
  </main>

  <footer class="pdp-footer" data-global-product-footer><div class="pdp-container pdp-footer__in"><span>© 2026 CHUANWEI FIRE</span><span><a href="{{ entry.navigation.categoryHref }}">{{ entry.navigation.labels.backToCategory }}</a> · <a href="{{ entry.navigation.productsHref }}">{{ entry.navigation.labels.productDirectory }}</a> · <a href="{{ entry.navigation.homeHref }}">{{ entry.navigation.labels.companyWebsite }}</a></span></div></footer>
  <div class="pdp-modal" id="productModal" role="dialog" aria-modal="true" aria-label="{{ entry.locale.navigation.gallery }}"><button type="button" aria-label="{{ entry.locale.common.close }}">×</button><div><img src="{{ entry.heroImage.src }}" alt="{{ entry.heroImage.alt }}"></div></div>
  <script src="{{ entry.route.assetPrefix }}assets/js/site-navigation.js"></script>
  <script src="{{ entry.route.assetPrefix }}assets/js/product-detail.js"></script>
  <div class="social-float"><a href="{{ entry.whatsAppHref }}" class="social-float__item social-float__item--whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" width="24" height="24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a></div>
</body>
</html>
